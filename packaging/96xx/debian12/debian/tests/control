# autopkgtest — runs in a throwaway container/VM with NO NVIDIA GPU present.
# The full harness lives in ../../tests/ of the flavour repo; these are the
# in-archive smoke tests.

Test-Command: /usr/share/nvidia-legacy-tests/install-purge.sh 96xx
Depends: nvidia-legacy-96xx-driver, nvidia-legacy-tests
Restrictions: needs-root, allow-stderr, isolation-container

Test-Command: /usr/share/nvidia-legacy-tests/file-conflicts.sh 96xx
Depends: nvidia-legacy-96xx-driver, nvidia-legacy-tests
Restrictions: needs-root, allow-stderr, isolation-container

Test-Command: /usr/share/nvidia-legacy-tests/dkms-build.sh 96xx
Depends: nvidia-legacy-96xx-kernel-dkms, nvidia-legacy-tests,
 linux-headers-generic | linux-headers-amd64
Restrictions: needs-root, allow-stderr, isolation-machine, skippable

# best-effort target: record result but never fail the pipeline
Test-Command: /usr/share/nvidia-legacy-tests/xorg-dummy.sh 96xx || true
Depends: nvidia-legacy-96xx-driver, nvidia-legacy-tests, xserver-xorg-core, xvfb
Restrictions: needs-root, allow-stderr, isolation-container, flaky
